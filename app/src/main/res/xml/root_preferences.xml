<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/cat_theme"
        app:iconSpaceReserved="false">
        <ListPreference
            app:key="tp_theme"
            app:title="@string/cat_theme"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/cat_ads_privacy"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="tp_block_ads"
            app:title="@string/pref_block_ads_title"
            app:summary="@string/pref_block_ads_desc"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="tp_block_screenshot_detect"
            app:title="@string/pref_block_screenshot_title"
            app:summary="@string/pref_block_screenshot_desc"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="tp_block_analytics"
            app:title="@string/pref_block_analytics_title"
            app:summary="@string/pref_block_analytics_desc"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="tp_strip_tracking"
            app:title="@string/pref_strip_tracking_title"
            app:summary="@string/pref_strip_tracking_desc"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

