<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base App Theme (Dark by default matching Threads aesthetic) -->
    <style name="Theme.ThreadsPulse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tp_coral_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/card_dark</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <style name="Theme.ThreadsPulse.Coral">
        <item name="colorPrimary">@color/tp_coral_primary</item>
    </style>

    <style name="Theme.ThreadsPulse.Ocean">
        <item name="colorPrimary">@color/tp_ocean_primary</item>
    </style>

    <style name="Theme.ThreadsPulse.Mint">
        <item name="colorPrimary">@color/tp_mint_primary</item>
    </style>

    <style name="Theme.ThreadsPulse.Lavender">
        <item name="colorPrimary">@color/tp_lavender_primary</item>
    </style>

    <style name="Theme.ThreadsPulse.Sakura">
        <item name="colorPrimary">@color/tp_sakura_primary</item>
    </style>

    <style name="Theme.ThreadsPulse.Amber">
        <item name="colorPrimary">@color/tp_amber_primary</item>
    </style>
</resources>
